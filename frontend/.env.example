# Public base URL of the site. Drives metadataBase, canonical tags,
# hreflang alternates, sitemap.xml and robots.txt.
#
# --- Local (default) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRAPI_URL=http://localhost:1337

# --- Production ---
# NEXT_PUBLIC_SITE_URL=https://www.beaconarabia.com
# STRAPI_URL=https://www.cms.beaconarabia.com

# Where THIS process fetches from, as opposed to the origin baked into image
# URLs for browsers (that is STRAPI_URL above). Defaults to STRAPI_URL, which is
# correct whenever the machine can reach the public CMS hostname.
#
# Set it when it cannot, or should not:
#
#  - On the server, if Cloudflare-proxied DNS plus blocked loopback hairpinning
#    leaves the origin with no route back to its own domain. Every server-side
#    fetch then hangs until it times out.
#
#  - When building. Pointing this at a local CMS keeps a build off the
#    production one entirely — which matters here, because the production host
#    is small enough that a build's concurrent fetches have taken it down:
#
#      STRAPI_URL=https://cms.beaconarabia.com \
#      STRAPI_INTERNAL_URL=http://localhost:1337 \
#      NEXT_PUBLIC_SITE_URL=https://beaconarabia.com \
#      npm run build
#
#    Content comes from the local CMS; image URLs still name the public one.
#    This only works while the two databases hold the same content.
#
# It must stay a separate variable: reusing STRAPI_URL would put a loopback
# address into the HTML as image src attributes, which next/image rejects in
# production as an SSRF risk.
# STRAPI_INTERNAL_URL=http://127.0.0.1:1337

# The read-only API token the CMS auto-provisions on first boot (see
# ensureApiToken in cms/src/index.ts). In development it writes itself
# straight into this file's STRAPI_API_TOKEN line. In production
# (NODE_ENV=production) it deliberately does NOT — it only logs the value once,
# since this file has no business existing on that host. Copy that logged
# value into whatever secret store your production frontend reads env vars
# from; it is shown exactly once and cannot be recovered afterwards (Strapi
# only keeps a hash of it).
STRAPI_API_TOKEN=

# EmailJS — powers the contact form, newsletter signup and the enquiry popup.
#
# These are read ONLY on the server (app/api/contact) and never reach the
# browser, so they must NOT carry the NEXT_PUBLIC_ prefix. Anything prefixed
# that way is inlined into the JavaScript bundle for anyone to read and reuse.
#
# Find them in the EmailJS dashboard: Email Services, Email Templates, and
# Account -> General for the public and private keys. All three legacy sites
# shared one service and template, so the `region` field the forms send is what
# identifies which regional site an enquiry came from.
#
# EMAILJS_PRIVATE_KEY is required: EmailJS rejects calls that don't come from a
# browser unless they carry it. In the same dashboard screen, enable "API
# requests from non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Setting allowed origins (EmailJS -> Account -> Security) is still worth doing
# as defence in depth, but it is no longer the only thing standing between the
# public and your send quota: the keys are server-side, and every submission
# passes a honeypot, a per-IP rate limit and (when configured) Turnstile.

# Cloudflare Turnstile — invisible bot check on the contact and popup forms.
# Create a widget at Cloudflare -> Turnstile; the site key is public, the secret
# key must stay server-side. Leave BOTH blank to disable: the forms keep
# working, protected by the honeypot and rate limit alone. If only one is set,
# the check stays off (they are only meaningful as a pair).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared secret for the Strapi -> Next revalidation webhook.
# Must match REVALIDATE_SECRET / the webhook header on the Strapi side.
# Generate a fresh value for production — don't reuse a value that has ever
# appeared in a chat, commit, or shared document.
REVALIDATE_SECRET=
