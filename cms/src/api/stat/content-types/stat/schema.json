{
  "kind": "collectionType",
  "collectionName": "stats",
  "info": {
    "singularName": "stat",
    "pluralName": "stats",
    "displayName": "Stat",
    "description": "An animated counter in the green stats banner."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "label": { "type": "string", "required": true },
