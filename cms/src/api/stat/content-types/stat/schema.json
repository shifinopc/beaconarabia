    "suffix": { "type": "string", "default": "+" },
    "order": { "type": "integer", "default": 0 },
    "region": {
      "type": "enumeration",
      "enum": ["global", "ae", "sa"],
      "required": true,
      "default": "global"
    }
  }
}
