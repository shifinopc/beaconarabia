{
  "kind": "collectionType",
  "collectionName": "offices",
  "info": {
    "singularName": "office",
    "pluralName": "offices",
    "displayName": "Office",
    "description": "A Beacon office shown on the contact page, grouped by country tab."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "city": { "type": "string", "required": true },
    "country": {
      "type": "enumeration",
      "enum": ["ksa", "uae", "bahrain", "qatar"],
      "required": true,
      "default": "ksa"
    },
    "address": { "type": "text", "required": true },
    "phones": { "type": "json" },
    "mapUrl": { "type": "string" },
    "wide": { "type": "boolean", "default": false },
    "order": { "type": "integer", "default": 0 }
  }
}
