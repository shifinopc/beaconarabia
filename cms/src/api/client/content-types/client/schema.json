{
  "kind": "collectionType",
  "collectionName": "clients",
  "info": {
    "singularName": "client",
    "pluralName": "clients",
    "displayName": "Client",
    "description": "Client/brand logo shown in the homepage logo strip."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "region": {
      "type": "enumeration",
      "enum": ["global", "ae", "sa"],
      "required": true,
      "default": "global"
    },
    "order": { "type": "integer", "default": 0 },
    "website": { "type": "string" }
  }
}
