{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Service offering (incorporation, tax, advisory...), per region."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "region": {
      "type": "enumeration",
      "enum": [
        "global",
        "ae",
        "sa"
      ],
      "required": true,
      "default": "global"
    },
    "summary": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "details": {
      "type": "json"
    },
    "seoTitle": {
      "type": "string",
      "maxLength": 60,
      "description": "Optional <title> for this service page, replacing the default (the service title, plus \" in <country>\" on regional pages). \" | Beacon\" is appended automatically, so do not type it. Leave empty to keep the default."
    }
  }
}
