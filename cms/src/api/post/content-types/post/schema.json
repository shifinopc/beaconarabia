{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": "Blog article. Replaces the Sanity-backed blog on the global site."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "region": {
      "type": "enumeration",
      "enum": [
        "global",
        "ae",
        "sa"
      ],
      "required": true,
      "default": "global"
    },
    "excerpt": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "coverUrl": {
      "type": "string"
    },
    "contentBlocks": {
      "type": "json"
    }
  }
}
