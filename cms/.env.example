HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Generate fresh values per environment. Never reuse the local ones in production.
#
# Exception: ENCRYPTION_KEY, if you migrate this local database to production
# rather than starting from an empty one. It decrypts the accessKey stored
# alongside the API token ensureApiToken already created here — change it and
# every existing token (including that one) becomes unreadable, and every
# authenticated request the frontend makes starts failing. Carry it over
# unchanged if the data is coming with you; generate fresh if the production
# database starts empty.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ---------------------------------------------------------------------------
# Production host
# ---------------------------------------------------------------------------
# NODE_ENV=production
#
# Uncomment if Strapi sits behind a reverse proxy terminating TLS (nginx, a
# load balancer, Vercel/Render/etc. in front of the app) — see config/server.ts
# for what these control. Leave both unset for a plain local/dev boot.
# PUBLIC_URL=https://www.cms.beaconarabia.com
# IS_PROXIED=true
#
# Comma-separated list of browser origins allowed to call this API directly.
# Nothing in this app currently does that (all reads go through the Next
# server; images load as plain <img>/next/image tags, neither of which is
# subject to CORS) — this is a hardening default, not a fix for something
# broken. See config/middlewares.ts.
# CORS_ORIGINS=https://www.beaconarabia.com

# ---------------------------------------------------------------------------
# Database
#
# Local development uses SQLite so nothing depends on database credentials.
# Switching to the MySQL server is env-only — no code changes. config/database.ts
# already ships connection blocks for mysql, postgres and sqlite, selected by
# DATABASE_CLIENT.
#
# Strapi 5 requires MySQL >= 8.0 (8.4 recommended). MySQL 5.7 is NOT supported.
# ---------------------------------------------------------------------------

# --- Local (default) ---
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# --- Production: comment out the two lines above and uncomment these ---
# DATABASE_CLIENT=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=beacon_cms
# DATABASE_USERNAME=beacon_cms
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# Frontend revalidation webhook — registered automatically on boot.
# REVALIDATE_SECRET must match the value in frontend/.env.local
#
# --- Local (default) ---
REVALIDATE_URL=http://localhost:3000/api/revalidate

# --- Production ---
# REVALIDATE_URL=https://www.beaconarabia.com/api/revalidate

REVALIDATE_SECRET=

# Off by default (ensurePublicReadAccess in src/index.ts) — the frontend reads
# via the auto-provisioned token above instead. Set to true only for a quick
# manual check with curl; leave unset for both local dev and production.
# STRAPI_PUBLIC_READ=true

# ---------------------------------------------------------------------------
# Rate limiting (src/middlewares/rate-limit.ts)
# ---------------------------------------------------------------------------
# Defaults are sensible; override only if you see legitimate traffic throttled.
#
# Authenticated requests are exempt, so these never affect the Next.js server
# or `next build` — they bound anonymous callers only. The auth limits apply to
# admin login attempts and are much stricter, since that is where a brute-force
# attempt would land.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=300000
